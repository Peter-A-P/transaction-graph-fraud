# Private working notes, never committed
CLAUDE.local.md

# Secrets and tokens
.env
.env.*
*.key
*.pem
kaggle.json

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/
*.egg-info/

# Data (loaders fetch and verify; nothing raw is committed). Manifests and split summaries
