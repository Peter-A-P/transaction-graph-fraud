/data/
data/raw/
data/graphs/
data/features/
# Evaluation runs: scores, outcomes, explanations, serving traces. Evidence for the tables,
# too large to commit; the report command publishes the summaries.
data/runs*/
data/bench/

# Models, checkpoints, exports (the ONNX handover is published as a release asset, not here)
checkpoints/
/models/
*.pt
*.onnx
*.safetensors

# Neo4j container state
neo4j/

# Runs and caches
runs/
.cache/
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3

# The built site (consort site writes it; the workflow deploys it)
site/out/

# OS and editors
.DS_Store
Thumbs.db
